# ---- Base de datos ----
DATABASE_URL="postgresql://medic:medic@localhost:5432/medic?schema=public"

# ---- Sesiones ----
# Generar con: openssl rand -base64 48
AUTH_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"
SESSION_MAX_AGE_HOURS="12"

# ---- Archivos adjuntos ----
# Carpeta donde se guardan fotos, documentos y comprobantes
UPLOAD_DIR="./storage/uploads"
MAX_UPLOAD_MB="20"

# ---- Parámetros del negocio (Chile) ----
IVA_RATE="0.19"
DEFAULT_CURRENCY="CLP"
TZ="America/Santiago"

# ---- App ----
APP_NAME="MEDIGEX"
APP_URL="http://localhost:3000"
